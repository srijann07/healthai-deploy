# ------------------------------------------------------------------
# HealthAI - Environment Configuration
# Copy this file to `.env` and fill in real values.
# ------------------------------------------------------------------

# Flask & Security
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET_KEY=change-me-to-another-long-random-string-32-chars
APP_BASE_URL=http://127.0.0.1:5000

# ------------------------------------------------------------------
# 1. Database Configuration (DBaaS)
# ------------------------------------------------------------------
# Cloud PostgreSQL (Supabase / Neon / Render) with visual dashboard:
#   DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# MySQL (Production / PythonAnywhere):
#   DATABASE_URL=mysql+pymysql://healthai_user:strong_password@localhost:3306/healthai
# Leave blank to fall back automatically to local SQLite:
DATABASE_URL=

# ------------------------------------------------------------------
# 2. Cloud Storage Configuration (BaaS / Blob Storage)
# ------------------------------------------------------------------
# Choose: 'local' (default) | 'firebase' | 'supabase'
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=10

# Firebase Cloud Storage (Visible in Google Firebase Web Console)
# 1. Download serviceAccountKey.json from Firebase Project Settings -> Service Accounts
# 2. Set the path and your bucket name:
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app

# Supabase Storage (Visible in Supabase Web Console)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=medical-reports

# ------------------------------------------------------------------
# 3. SMS OTP Configuration (Optional for real Indian SMS)
# ------------------------------------------------------------------
# Leave blank to print OTPs directly to terminal/console in development
FAST2SMS_API_KEY=

# ------------------------------------------------------------------
# 4. Initial Seed Admin Account
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@healthai.local
ADMIN_PASSWORD=Admin@12345
